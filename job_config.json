{
  "name": "realtime_retail_order_pipeline",
  "email_notifications": {
    "on_failure": ["your_email@example.com"]
  },
  "schedule": {
    "quartz_cron_expression": "0 */5 * * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "notebook_task": {
        "notebook_path": "/Repos/your_username/databricks_realtime_project/notebooks/01_bronze_autoloader_ingestion",
        "base_parameters": {
          "landing_path": "/Volumes/main/retail/landing/streaming_orders",
          "schema_location": "/Volumes/main/retail/checkpoints/bronze_schema",
          "checkpoint_path": "/Volumes/main/retail/checkpoints/bronze",
          "bronze_table": "main.retail.raw_orders_bronze"
        }
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1
      },
      "timeout_seconds": 3600,
      "max_retries": 2
    },
    {
      "task_key": "silver_transformation",
      "depends_on": [{ "task_key": "bronze_ingestion" }],
      "notebook_task": {
        "notebook_path": "/Repos/your_username/databricks_realtime_project/notebooks/02_silver_transformation_streaming",
        "base_parameters": {
          "bronze_table": "main.retail.raw_orders_bronze",
          "silver_table": "main.retail.orders_silver",
          "quarantine_table": "main.retail.orders_silver_quarantine",
          "checkpoint_path": "/Volumes/main/retail/checkpoints/silver",
          "quarantine_checkpoint_path": "/Volumes/main/retail/checkpoints/silver_quarantine"
        }
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1
      },
      "timeout_seconds": 3600,
      "max_retries": 2
    },
    {
      "task_key": "gold_aggregation",
      "depends_on": [{ "task_key": "silver_transformation" }],
      "notebook_task": {
        "notebook_path": "/Repos/your_username/databricks_realtime_project/notebooks/03_gold_aggregation_streaming",
        "base_parameters": {
          "silver_table": "main.retail.orders_silver",
          "revenue_table": "main.retail.revenue_by_category_5min",
          "region_table": "main.retail.orders_by_region",
          "top_products_table": "main.retail.top_products",
          "checkpoint_root": "/Volumes/main/retail/checkpoints/gold"
        }
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1
      },
      "timeout_seconds": 3600,
      "max_retries": 2
    }
  ],
  "format": "MULTI_TASK",
  "_comment_how_to_import": "Update notebook_path values to match your Repo location, then run: databricks jobs create --json @workflow/job_config.json. Set pause_status to UNPAUSED once verified.",
  "_comment_note_on_streaming_jobs": "In production, tasks 1-3 use trigger(availableNow=True) instead of a fixed processingTime so each scheduled job run processes all currently-available new files then exits cleanly, rather than running forever. For the always-on/continuous version used to LEARN and DEMO the project (as in the README), run notebooks 01-03 interactively instead of via this job."
}
